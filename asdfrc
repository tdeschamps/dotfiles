# ~/.asdfrc — asdf's machine configuration.
# Reference: https://asdf-vm.com/manage/configuration.html

# Read .ruby-version, .nvmrc, .python-version and friends, not just
# .tool-versions. Most repos still ship the language-specific file.
legacy_version_file = yes

# Delete source archives after a successful install.
always_keep_download = no

# Use every core when compiling a runtime.
concurrency = auto
